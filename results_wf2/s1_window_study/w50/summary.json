        "buffer_size_separability": 100
      },
      "w200": {
        "max_rules": 5,
        "tau_merge": 0.62,
        "safe_threshold": 0.07,
        "min_firing_for_update": 0.05,
        "drift_sensitivity": 0.35,
        "buffer_size_separability": 200
      },
      "w500": {
        "max_rules": 5,
        "tau_merge": 0.62,
        "safe_threshold": 0.07,
        "min_firing_for_update": 0.05,
        "drift_sensitivity": 0.35,
        "buffer_size_separability": 500
      },
      "w1000": {
        "max_rules": 5,
        "tau_merge": 0.62,
        "safe_threshold": 0.07,
        "min_firing_for_update": 0.05,
        "drift_sensitivity": 0.35,
        "buffer_size_separability": 1000
      }
    },
    "checkpoint_every": 50,
    "acc_window": 500,
    "analysis": {
      "lags_samples": [
        50,
