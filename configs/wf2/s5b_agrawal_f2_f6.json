    "type": "agrawal",
    "n": 20000,
    "function_before": 2,
    "function_after": 6,
    "drift_at": 10000,
    "drift_width": 0
  },
  "variants": {
    "ref": {
      "max_rules": 5,
      "tau_merge": 0.62,
      "safe_threshold": 0.07,
      "min_firing_for_update": 0.05,
      "drift_sensitivity": 0.35
    },
    "open": {
      "max_rules": null,
      "tau_merge": 0.62,
      "safe_threshold": 0.07,
      "min_firing_for_update": 0.05,
      "drift_sensitivity": 0.35
    }
  },
  "checkpoint_every": 50,
